    "/api/access-records": {
      "post": {
        "tags": [
          "AccessRecords"
        ],
        "summary": "Procesa una solicitud de acceso. El intento siempre queda registrado: el campo\r\n`result` indica si fue autorizado y `rejectionReason` el motivo de rechazo.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAccessCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAccessCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAccessCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRecordDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "AccessRecords"
        ],
        "summary": "Historial de accesos filtrable y paginado.",
        "parameters": [
          {
            "name": "employeeId",
            "in": "query",
            "description": "Empleado.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "fromUtc",
            "in": "query",
            "description": "Fecha/hora inicial (UTC, inclusiva). Ej: 2026-10-01T00:00:00Z",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toUtc",
            "in": "query",
            "description": "Fecha/hora final (UTC, inclusiva).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "accessPointId",
            "in": "query",
            "description": "Punto de acceso.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "result",
            "in": "query",
            "description": "Authorized o Rejected.",
            "schema": {
              "$ref": "#/components/schemas/AccessResult"
            }
          },
          {
            "name": "movementType",
            "in": "query",
            "description": "Entry o Exit.",
            "schema": {
              "$ref": "#/components/schemas/MovementType"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Página (desde 1).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Tamaño de página (máximo 100).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRecordDtoPagedResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
